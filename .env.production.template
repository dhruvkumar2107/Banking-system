# ══════════════════════════════════════════════════════════════════════════════
# Digital Pigmee — PRODUCTION environment template
#
# Copy to `apps/api/.env` on the production host (or paste into your platform's
# secret manager — Railway/Render/AWS variables). Do NOT commit the filled copy.
#
# Every line marked  <<< FILL >>>  needs a value that only the bank can provide
# (see deliverables/PROJECT-HEAD-INPUTS.md). Everything else is ready to go.
#
# The API REFUSES TO BOOT in production if any secret is still a dev default —
# see productionReadinessIssues() in src/config/app-config.service.ts. That is
# deliberate: a misconfigured deploy fails loudly instead of running insecurely.
# ══════════════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=4000

# Public base URL of the API itself (used in receipts + webhook registration).
API_BASE_URL=https://<<< FILL: api.yourbank.com >>>

# ── Database ──────────────────────────────────────────────────────────────────
# Managed Postgres 14+. When this is set, PGlite is not used at all.
# Format: postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=<<< FILL: managed Postgres connection string >>>

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Freshly generated for this handover (2026-08-20). Rotating these logs everyone
# out; otherwise they need no maintenance. Store in the company secret vault.
JWT_ACCESS_SECRET=4faq6qDh-vyf4ngadAt_WgHfMGb0Mk230TQ7e54zFDVULbGqoCZ4bM1JnaTUY5mT
JWT_REFRESH_SECRET=dmfHoMovarOZUeKeZXOmeDI3NG9d7XF6qaVMuHvQr11BVXS4v-zrBbKBvDkswrFO
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# ── OTP / SMS ─────────────────────────────────────────────────────────────────
# MUST be false in production — `true` returns the OTP in the HTTP response,
# which would let anyone log in as any customer.
OTP_DEV_ECHO=false
OTP_TTL=300
OTP_LENGTH=6
OTP_MAX_PER_HOUR=5

# Pick ONE provider and fill its block. Both are fully implemented.
SMS_PROVIDER=<<< FILL: msg91 (India) or twilio >>>

# MSG91 — India. Transactional SMS to Indian numbers also requires a TRAI DLT
# registered template; the OTP text must match the approved template exactly.
MSG91_AUTH_KEY=<<< FILL if msg91 >>>
MSG91_SENDER_ID=<<< FILL if msg91: 6-char approved sender, e.g. PIGMEE >>>
MSG91_ROUTE=4
MSG91_DLT_TEMPLATE_ID=<<< FILL if msg91: DLT template id >>>

# Twilio — global fallback.
TWILIO_ACCOUNT_SID=<<< FILL if twilio >>>
TWILIO_AUTH_TOKEN=<<< FILL if twilio >>>
TWILIO_FROM=<<< FILL if twilio: +1... sending number >>>

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
# NOTE ON UAT: with NODE_ENV=production the API refuses to boot unless payments
# are live with real keys. So for a mock-money UAT/staging run, set
# NODE_ENV=staging (anything other than "production") and PAYMENTS_MODE=mock.
# Use NODE_ENV=production only for the real go-live with live keys.
PAYMENTS_MODE=<<< FILL: live for go-live (mock only with NODE_ENV=staging) >>>
RAZORPAY_KEY_ID=<<< FILL: rzp_live_... >>>
RAZORPAY_KEY_SECRET=<<< FILL: live key secret >>>
# Set this to the same secret you type into the Razorpay dashboard when adding
# the webhook. Webhook URL to register there:
#   https://<your-api-domain>/api/payments/webhook
# Subscribe to events: payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=<<< FILL: webhook secret you choose in Razorpay >>>

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated exact origins allowed to call the API. Add the admin panel's
# real domain. Do NOT use "*" — credentials are sent cross-origin.
CORS_ORIGINS=https://<<< FILL: admin.yourbank.com >>>
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ── Scheduled jobs ────────────────────────────────────────────────────────────
# Payment reminders + missed-pigmy detection. Cron is in server local time.
REMINDERS_ENABLED=true
REMINDERS_CRON=0 18 * * *
MISSED_PIGMY_DAYS=3
# Sweep that settles payments left "pending" if a callback was lost.
RECONCILE_ENABLED=true
# Daily maturity sweep: flags accounts whose term has ended and notifies the
# customer. Moves no money — interest is credited when the payout is recorded.
MATURITY_CRON=30 1 * * *

# ── KYC file uploads ──────────────────────────────────────────────────────────
# Customer profile photos and KYC document scans. This is PERSONAL DATA:
#   • served only via the authenticated GET /api/uploads/... route (never static),
#   • readable only by the owning customer and admins assigned to their village,
#   • validated by magic bytes, not just the declared Content-Type.
# Point this at a persistent, BACKED-UP volume — losing it means re-collecting
# every customer's KYC. Include it in the same backup schedule as the database.
UPLOAD_DIR=<<< FILL: /var/lib/pigmee/uploads >>>
UPLOAD_MAX_BYTES=5242880

# ── First admin user (created once by `npm run seed`) ─────────────────────────
# Change this password immediately after first login (Settings → Password).
SEED_SUPERADMIN_EMAIL=<<< FILL: real admin email >>>
SEED_SUPERADMIN_PASSWORD=8Xkvbx4GBlT1PcI4@9
