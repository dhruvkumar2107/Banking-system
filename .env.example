# ─────────────────────────────────────────────────────────────
# Digital Pigmee — API environment
# Copy to `apps/api/.env` and adjust. All values below are safe dev defaults.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# ── Database ──────────────────────────────────────────────────
# If DATABASE_URL is set, the API connects to that Postgres (production / staging).
# If it is EMPTY, the API falls back to PGlite (embedded Postgres, WASM) using a
# local file store at apps/api/.data/pigmee — zero setup, real Postgres semantics.
DATABASE_URL=
# Where PGlite stores data when DATABASE_URL is empty ("memory://" for in-memory).
PGLITE_PATH=.data/pigmee

# ── Auth / JWT ────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=900          # seconds (15m)
JWT_REFRESH_TTL=1209600     # seconds (14d)

# ── OTP ───────────────────────────────────────────────────────
# In dev, OTPs are returned in the API response / logged instead of sent via SMS.
OTP_TTL=300                 # seconds (5m)
OTP_LENGTH=6
OTP_MAX_PER_HOUR=5          # rate limit per mobile number
OTP_DEV_ECHO=true           # true => return the OTP in the API response (dev only)
SMS_PROVIDER=console        # console (logs only) | msg91 | twilio — all three implemented

# MSG91 (India). Required when SMS_PROVIDER=msg91.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=PIGMEE
MSG91_ROUTE=4               # 4 = transactional
MSG91_DLT_TEMPLATE_ID=      # required by TRAI DLT rules for Indian transactional SMS

# Twilio (global). Required when SMS_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                # e.g. +15551234567

# ── Razorpay ──────────────────────────────────────────────────
# Leave key/secret empty to run payments in MOCK mode (fully testable, no real gateway).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=dev_webhook_secret_change_me
PAYMENTS_MODE=mock          # mock | live  (auto-forced to mock if keys are absent)

# ── Security ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
THROTTLE_TTL=60             # seconds
THROTTLE_LIMIT=120          # requests per TTL per IP

# ── Maturity sweep ────────────────────────────────────────────
# Daily job that flags accounts whose term has ended and notifies the customer.
# It moves NO money — interest is credited only when a maturity withdrawal is
# paid out, so there is exactly one ledger code path.
MATURITY_CRON=30 1 * * *    # 01:30 server local time

# ── KYC file uploads ──────────────────────────────────────────
# Where customer profile photos and KYC documents are written. Relative paths
# resolve against the API's working directory (apps/api), like PGLITE_PATH.
# These files are customer PII: they are served only through the authenticated
# GET /api/uploads/... route, never as static files, and the directory is
# git-ignored. Back it up alongside the database.
UPLOAD_DIR=storage/uploads
UPLOAD_MAX_BYTES=5242880    # 5 MB; JPEG/PNG/WebP/PDF only (verified by magic bytes)

# ── Seed admin (created by `npm run seed`) ────────────────────
SEED_SUPERADMIN_EMAIL=admin@pigmee.bank
SEED_SUPERADMIN_PASSWORD=Admin@12345
