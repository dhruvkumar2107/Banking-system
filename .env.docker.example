# Overrides for `docker compose`. Copy to `.env` in this same directory:
#
#   cp .env.docker.example .env
#
# docker compose reads `.env` automatically for the ${VAR} substitutions in
# docker-compose.yml. Everything here has a dev-safe default in the compose file,
# so you only need to set what you want to change. LEAVE THIS FILE as the template.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=pigmee
POSTGRES_PASSWORD=pigmee
POSTGRES_DB=pigmee
POSTGRES_PORT=5432

# ── Published host ports ──────────────────────────────────────────────────────
API_PORT=4000
ADMIN_PORT=3000

# ── Public URLs (change when deploying behind real domains) ───────────────────
API_BASE_URL=http://localhost:4000
# Baked into the admin browser bundle at build time — must include /api.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
# Comma-separated list of origins allowed to call the API (the admin + app).
CORS_ORIGINS=http://localhost:3000

# ── Secrets — REPLACE ALL OF THESE BEFORE ANY PUBLIC DEPLOYMENT ────────────────
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
RAZORPAY_WEBHOOK_SECRET=dev_webhook_secret_change_me
SEED_SUPERADMIN_EMAIL=admin@pigmee.bank
SEED_SUPERADMIN_PASSWORD=Admin@12345

# ── Runtime mode ──────────────────────────────────────────────────────────────
# `staging` runs the full stack with mock payments and echoed OTPs — this is what
# makes the zero-config demo work. Switch to `production` ONLY once real Razorpay
# keys, a real SMS provider, and non-default secrets are all set below: the API
# checks them at boot and refuses to start if any are still demo values.
NODE_ENV=staging

# ── OTP / SMS ─────────────────────────────────────────────────────────────────
# true => OTP is returned in the API response (no SMS gateway needed for demos).
# Set to false in production and wire a real SMS provider.
OTP_DEV_ECHO=true
SMS_PROVIDER=console

# ── KYC file uploads ──────────────────────────────────────────────────────────
# Customer photos and KYC documents. The path is inside the container and is
# backed by the `pigmee_uploads` named volume, so files survive a rebuild.
# `docker compose down -v` DELETES them — take a backup first.
UPLOAD_DIR=storage/uploads
UPLOAD_MAX_BYTES=5242880

# ── Payments ──────────────────────────────────────────────────────────────────
# Stays in mock mode (no real charges) until live keys are set AND mode=live.
PAYMENTS_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
