# Digital Pigmee — Admin Panel environment
# Copy to `.env.local`. The admin panel is a browser app; only NEXT_PUBLIC_* vars
# are exposed to the client.

# Base URL of the API, including the /api prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Used only by the dev rewrite proxy (server-side), optional.
API_INTERNAL_URL=http://localhost:4000
