name: pigmee_customer
description: "Digital Pigmee — customer app for daily micro-savings (pigmy) deposits."
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: ^3.13.0

dependencies:
  flutter:
    sdk: flutter
  flutter_localizations:
    sdk: flutter

  cupertino_icons: ^1.0.8
  # HTTP client with interceptors (auth + refresh).
  dio: ^5.7.0
  # State management.
  flutter_riverpod: ^2.6.1
  # Declarative routing with auth-aware redirects.
  go_router: ^14.6.2
  # JWT tokens live in the platform keystore, never in plain prefs.
  flutter_secure_storage: ^11.0.0
  # Locale preference persistence.
  shared_preferences: ^2.3.3
  # en-IN / hi number, currency and date formatting.
  intl: ^0.20.2
  # Writes downloaded receipt PDFs to the app documents directory.
  path_provider: ^2.1.6
  # Camera / gallery capture for the KYC profile photo.
  image_picker: ^1.1.2
  # Picks a PDF or image from device storage for KYC document upload.
  # Must stay >=11: file_picker 8.x compiles its Android module against API 34,
  # while its own flutter_plugin_android_lifecycle dependency now requires
  # consumers to target 36+, so the 8.x release fails `checkReleaseAarMetadata`.
  file_picker: ^12.0.0
  # Native share sheet — sends the downloaded receipt PDF to WhatsApp, mail, etc.
  # Must stay >=13: every earlier release applies the Kotlin Gradle Plugin in its
  # own Android module, which AGP 9 rejects (see android/gradle.properties).
  share_plus: ^13.3.0
  # Razorpay native checkout for live payments (mock mode bypasses this).
  razorpay_flutter: ^1.3.7
  # Launches tel:/mailto: from the help & support screen.
  url_launcher: ^6.3.0

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^6.0.0

flutter:
  uses-material-design: true
