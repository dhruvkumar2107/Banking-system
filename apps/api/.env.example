NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Empty DATABASE_URL => PGlite embedded Postgres (local file store). Set to a
# postgres:// URL to use a real Postgres instead.
DATABASE_URL=
PGLITE_PATH=.data/pigmee

JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

OTP_TTL=300
OTP_LENGTH=6
OTP_MAX_PER_HOUR=5
OTP_DEV_ECHO=true
SMS_PROVIDER=console

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=dev_webhook_secret_change_me
PAYMENTS_MODE=mock

CORS_ORIGINS=http://localhost:3000,http://localhost:4000
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Daily notifications scheduler (nudge customers to keep their pigmy streak).
REMINDERS_ENABLED=true
REMINDERS_CRON=0 18 * * *
MISSED_PIGMY_DAYS=3

# Daily maturity sweep (flags matured accounts + notifies; moves no money).
MATURITY_CRON=30 1 * * *

SEED_SUPERADMIN_EMAIL=admin@pigmee.bank
SEED_SUPERADMIN_PASSWORD=Admin@12345
